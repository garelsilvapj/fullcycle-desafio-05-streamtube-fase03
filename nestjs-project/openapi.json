              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Thumbnail do vídeo",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/download": {
      "get": {
        "description": "Redireciona (302) para a URL pré-assinada do MP4 processado.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do vídeo",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect para o arquivo"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Vídeo de outro canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Vídeo não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Vídeo ainda não está pronto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Baixar vídeo",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/stream": {
      "get": {
        "description": "Serve o MP4 processado com suporte a HTTP Range: sem header responde 200 com o arquivo inteiro; com `Range: bytes=...` responde 206 Partial Content. Range inválido responde 416.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do vídeo",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo inteiro (video/mp4)"
          },
          "206": {
            "description": "Faixa parcial (Content-Range)"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Vídeo de outro canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Vídeo não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Vídeo ainda não está pronto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range não satisfatível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Streaming do vídeo",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "SingleUploadPlanDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "single"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL pré-assinada para o PUT do arquivo inteiro."
          }
        },
        "required": [
          "type",
          "url"
        ]
      },
      "UploadPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "URL pré-assinada para o PUT desta parte."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "MultipartUploadPlanDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multipart"
            ]
          },
          "uploadId": {
            "type": "string"
          },
          "partSize": {
            "type": "number",
            "description": "Tamanho de cada parte em bytes (a última pode ser menor)."
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartDto"
            }
          }
        },
        "required": [
          "type",
          "uploadId",
          "partSize",
          "parts"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Meu primeiro vídeo",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "example": "Descrição do vídeo",
            "maxLength": 5000
          },
          "sizeBytes": {
            "type": "number",
            "description": "Tamanho declarado do arquivo em bytes (máx. 10GB). Acima do threshold do storage o upload usa multipart.",
            "example": 5000000,
            "minimum": 1,
            "maximum": 10737418240
          }
        },
        "required": [
          "title"
        ]
      },
      "VideoStatus": {
        "type": "string",
        "enum": [
          "uploading",
          "uploaded",
          "processing",
          "ready",
          "failed"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "aB3dE5fG7hI",
            "description": "URL curta única"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "durationSec": {
            "type": "number",
            "nullable": true
          },
          "sizeBytes": {
            "type": "number",
            "nullable": true,
            "description": "Tamanho em bytes do arquivo servido (original após confirmar; processado quando ready)."
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Caminho relativo da thumbnail na API (null até o processamento).",
            "example": "/videos/3f2b.../thumbnail"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Último erro de processamento. Presente apenas para o dono do canal."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "status",
          "durationSec",
          "sizeBytes",
          "thumbnailUrl",
          "error",
          "createdAt",
          "updatedAt"
        ]
      },
      "RegisterVideoResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "description": "Plano de upload: `single` (um PUT) ou `multipart` (várias partes + complete).",
            "oneOf": [
              {
                "$ref": "#/components/schemas/SingleUploadPlanDto"
              },
              {
                "$ref": "#/components/schemas/MultipartUploadPlanDto"
              }
            ]
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "CompletedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "description": "ETag devolvido pelo storage no PUT da parte.",
            "example": "\"9bb58f26192e4ba00f01e2e7b136bbd8\""
          }
        },
        "required": [
          "partNumber",
          "etag"
        ]
      },
      "CompleteMultipartDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "uploadId devolvido no registro do vídeo."
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartDto"
            }
          }
        },
        "required": [
          "uploadId",
          "parts"
        ]
      },
      "AbortMultipartDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "uploadId devolvido no registro do vídeo."
          }
        },
        "required": [
          "uploadId"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}