# Application
NODE_ENV=development
PORT=3000
# URL pública da API (usada nos links dos e-mails)
APP_URL=http://localhost:3000
# Swagger UI em /api/docs (desligado por padrão)
SWAGGER_ENABLED=false

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
# aspas simples para o valor não quebrar o parser do docker compose (o '<' é literal)
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# --- Fase 03: Object storage (MinIO/S3) ---
S3_ENDPOINT=http://minio:9000
# Endpoint usado só para ASSINAR as URLs entregues ao cliente (host/navegador não resolve `minio`)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES=3600
# Acima do threshold o upload é multipart; tamanho de cada parte (mín. 5MB, máx. 5GB)
S3_MULTIPART_THRESHOLD=104857600
S3_MULTIPART_PART_SIZE=104857600

# --- Fase 03: Fila (Redis/BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379
