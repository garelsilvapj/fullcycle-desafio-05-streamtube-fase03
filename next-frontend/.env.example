# Copie para .env.local. Todas as variáveis são lidas exclusivamente por lib/env.ts.

# URL da API NestJS (server-only; nunca exponha como NEXT_PUBLIC_*).
# - Dev com as duas stacks Docker separadas (padrão): o container do Next alcança a API
#   publicada no host via host.docker.internal (extra_hosts no compose.yaml).
API_URL=http://host.docker.internal:3000
# - Rodando o Next no host: API_URL=http://localhost:3000
# - Se as stacks compartilharem a mesma rede Docker: API_URL=http://nestjs-api:3000

# Senha do cookie de sessão (iron-session). Mínimo de 32 caracteres.
SESSION_PASSWORD=change-me-to-a-random-string-with-32-plus-chars

# Ative para interceptar as chamadas à API com MSW (necessário para os testes E2E do Playwright).
# MSW_ENABLED=true
