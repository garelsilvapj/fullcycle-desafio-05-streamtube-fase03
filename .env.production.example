# Copie para .env.production e preencha os segredos. Lido pelo compose.prod.yaml (API e worker).
NODE_ENV=production
PORT=3000
APP_URL=https://streamtube.example.com

# Banco
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=change-me
DB_NAME=streamtube

# JWT (gere com: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# E-mail (SMTP real)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM='"StreamTube" <noreply@streamtube.example.com>'

# Storage (MinIO do compose ou S3 real)
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true
# URL do storage alcançável pelo navegador (atrás do proxy TLS)
S3_PUBLIC_ENDPOINT=https://storage.streamtube.example.com
S3_PRESIGN_EXPIRES=3600
S3_MULTIPART_THRESHOLD=104857600
S3_MULTIPART_PART_SIZE=104857600

# Fila
REDIS_PORT=6379
WORKER_CONCURRENCY=1
WORKER_LOCK_DURATION_MS=300000

# Frontend (iron-session; 32+ chars)
SESSION_PASSWORD=change-me-to-a-random-string-with-32-plus-chars
SWAGGER_ENABLED=false
